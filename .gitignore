# Build artifacts - NEVER commit
dist/
unpacked/
node_modules/
__pycache__/
*.pyc
*.pyo

# Native build temp dirs
/tmp/mmx-*
/tmp/asar-*
/tmp/asar-tool/
/tmp/asar3/
/tmp/asar401/
/tmp/electron-dist/
/tmp/glibc-shim/
/tmp/libm-shim*
/tmp/pi-*
/tmp/asar-orig/
/tmp/asar-extract*/
/tmp/asar7z/
/tmp/test-*
/tmp/rebuild*.log

# Editor
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db

# Logs
*.log

# Test outputs
/tmp/mmx-app-v3/
/tmp/mmx-from-asar-orig/
/tmp/deb-*/

# The original Windows installer
*.exe

# Sensitive (just in case)
.env
.env.local
.test-logs/

# Project-specific input/working dirs (this repo's convention, never commit)
inputs/

# unpacked/ holds raw NSIS extraction (1.6 GB) — regenerated on every fresh build
unpacked/
# mmx-patch: exception for icon.png (7KB, used by build-deb.sh). Without this,
# a fresh clone would need to re-run NSIS unpack + icon extraction just to build.
!unpacked/app-64/resources/resources/icon.png

# mmx-patch: dist-lib/ holds libfmod_shim.so (GLIBC_2.38 fmod fallback, 14KB).
# This is an intermediate build artifact that we DO commit so a fresh clone
# can build-deb without re-running the shim compile (which needs Linux gcc + .symver).
# Final .deb (dist/) is still ignored.
!dist-lib/
!dist-lib/libfmod_shim.so
